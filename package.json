{
  "name": "cisco-attendance-register",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs && node tests/dom.cjs && node tests/appraisal-dom.cjs",
    "build": "node scripts/build.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node scripts/serve.cjs",
    "test:browser": "node scripts/serve-and-test.cjs",
    "test:coverage": "c8 --include=learner-import.js --include=appraisal-config.js --include=scripts/config.cjs --check-coverage --lines=40 --branches=60 --functions=30 npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "11.0.0",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
